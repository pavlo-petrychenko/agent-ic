      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (job_name, le) (rate(job_duration_seconds_bucket{namespace=\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "{{job_name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "exemplar": true
        }
      ]
    },
