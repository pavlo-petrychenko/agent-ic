          "$ref": "#/definitions/nonEmptyString"
        }
      }
    },
    "keda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serverAddress"],
          "properties": {
            "serverAddress": {
              "type": "string",
              "format": "uri"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["prometheus"]
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "dashboards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "labels", "backendDown", "queueWait"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "backendDown": {
          "type": "object",
          "additionalProperties": false,
          "required": ["for", "severity"],
          "properties": {
            "for": {
              "$ref": "#/definitions/duration"
            },
