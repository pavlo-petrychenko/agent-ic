{
  "uid": "demo-live-writes",
  "title": "Live writes",
  "description": "Load, database writes and the newest rows, in real time",
  "tags": ["demo"],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "text",
      "title": "",
      "options": {
        "mode": "markdown",
        "content": "**Live writes.** k6 drives chats, agent edits and prompt edits through the API. Every request writes rows to Postgres. The tables at the bottom read the newest rows straight from the database with the read-only `grafana_reader` role. Click a trace id to open the whole request in Tempo."
      },
      "transparent": true,
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      }
    },
    {
      "type": "stat",
      "title": "Rows written / s",
      "description": "Inserted, updated and deleted rows per second in the agent_ic database (postgres-exporter).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"agent_ic\"}[1m]) + rate(pg_stat_database_tup_updated{datname=\"agent_ic\"}[1m]) + rate(pg_stat_database_tup_deleted{datname=\"agent_ic\"}[1m]))",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Transactions / s",
      "description": "Committed transactions per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_xact_commit{datname=\"agent_ic\"}[1m]))",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "API requests / s",
      "description": "Requests k6 sends to the API per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total[1m]))",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Runs finished / min",
      "description": "Agent runs the worker finished per minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(runs_finished_total[2m])) * 60",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "LLM calls / min",
      "description": "Calls to the (mock) LLM per minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "yellow"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(llm_calls_total[2m])) * 60",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Virtual users",
      "description": "k6 virtual users right now (steady load plus any burst).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(k6_vus)",
          "legendFormat": "",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Load: API requests per second (k6)",
      "description": "Requests per second sent by k6, per scenario, and the failed ones.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (scenario) (rate(k6_http_reqs_total[1m]))",
          "legendFormat": "{{scenario}}",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(k6_http_reqs_total{expected_response=\"false\"}[1m]))",
          "legendFormat": "failed",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency p95: client vs server",
      "description": "p95 latency seen by k6, by the api itself (dots are exemplars: click one to open its trace) and from sending a chat message to receiving the agent's reply.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_http_req_duration_p95)",
          "legendFormat": "k6 (client)",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{role=\"api\"}[1m])))",
          "legendFormat": "api (server)",
          "exemplar": true,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(k6_chat_reply_seconds_p95)",
          "legendFormat": "chat reply (message to answer)",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Database writes per second",
      "description": "Rows changed per second in Postgres (pg_stat_database).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_tup_inserted{datname=\"agent_ic\"}[1m]))",
          "legendFormat": "inserted",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_tup_updated{datname=\"agent_ic\"}[1m]))",
          "legendFormat": "updated",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(pg_stat_database_tup_deleted{datname=\"agent_ic\"}[1m]))",
          "legendFormat": "deleted",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Pipeline: runs and LLM calls per minute",
      "description": "Finished runs by status and LLM calls by outcome. The mock LLM fails about 3% of calls on purpose, so the fallback and retry paths show up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(runs_finished_total[2m])) * 60",
          "legendFormat": "runs {{status}}",
          "exemplar": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (outcome) (rate(llm_calls_total[2m])) * 60",
          "legendFormat": "llm {{outcome}}",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 11,
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Rows in the busiest tables",
      "description": "Live rows per table, growing as the load writes.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (schemaname, relname) (pg_stat_user_tables_n_live_tup{datname=\"agent_ic\", relname=~\"messages|conversations|runs|run_steps|prompt_versions|agent_versions\"})",
          "legendFormat": "{{schemaname}}.{{relname}}",
          "exemplar": false,
          "range": true
        }
      ],
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Latest messages",
      "description": "The newest rows of conversations.messages, read straight from Postgres every refresh.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select m.created_at as \"time\", m.author::text as author, left(m.text, 120) as text, a.name as agent\nfrom conversations.messages m\njoin conversations.conversations c on c.id = m.conversation_id\nleft join runs.runs r on r.id = m.run_id\nleft join agents.agents a on a.id = r.agent_id\norder by m.created_at desc limit 15"
        }
      ],
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 12,
        "h": 11
      }
    },
    {
      "type": "table",
      "title": "Latest runs",
      "description": "The newest agent runs. Click a trace id to open the request's trace in Tempo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open trace",
                    "url": "/explore?left=${__url_time_range:queryparam}&schemaVersion=1&panes=%7B%22t%22:%7B%22datasource%22:%22tempo%22,%22queries%22:%5B%7B%22refId%22:%22A%22,%22datasource%22:%7B%22type%22:%22tempo%22,%22uid%22:%22tempo%22%7D,%22queryType%22:%22traceql%22,%22query%22:%22${__value.raw}%22%7D%5D%7D%7D"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "succeeded": {
                        "color": "green",
                        "index": 0
                      },
                      "failed": {
                        "color": "red",
                        "index": 1
                      },
                      "escalated": {
                        "color": "orange",
                        "index": 2
                      },
                      "running": {
                        "color": "blue",
                        "index": 3
                      },
                      "queued": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select r.created_at as \"time\", a.name as agent, r.status::text as status, r.mode::text as mode,\n  round(extract(epoch from (r.finished_at - r.created_at))::numeric, 2) as seconds, r.trace_id\nfrom runs.runs r join agents.agents a on a.id = r.agent_id\norder by r.created_at desc limit 15"
        }
      ],
      "id": 14,
      "gridPos": {
        "x": 12,
        "y": 30,
        "w": 12,
        "h": 11
      }
    },
    {
      "type": "table",
      "title": "Latest prompt versions",
      "description": "Prompt versions the load saves every ~20 seconds.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select v.created_at as \"time\", p.name as prompt, v.number as version, left(v.text, 100) as text\nfrom prompts.prompt_versions v join prompts.prompts p on p.id = v.prompt_id\norder by v.created_at desc limit 10"
        }
      ],
      "id": 15,
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 12,
        "h": 9
      }
    },
    {
      "type": "table",
      "title": "Row counts",
      "description": "Exact row counts, counted in Postgres on every refresh.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "select 'conversations.messages' as \"table\", count(*) as rows from conversations.messages\nunion all select 'conversations.conversations', count(*) from conversations.conversations\nunion all select 'runs.runs', count(*) from runs.runs\nunion all select 'runs.run_steps', count(*) from runs.run_steps\nunion all select 'prompts.prompt_versions', count(*) from prompts.prompt_versions\nunion all select 'agents.agents', count(*) from agents.agents\nunion all select 'identity.users', count(*) from identity.users"
        }
      ],
      "id": 16,
      "gridPos": {
        "x": 12,
        "y": 41,
        "w": 12,
        "h": 9
      }
    }
  ]
}
