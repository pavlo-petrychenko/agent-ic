{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsup.config.ts",
        ".swcrc",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "inputs": ["src/**", "test/**", "tsconfig.json", "package.json"]
    },
    "test": {
      "inputs": ["src/**", "test/**", "vitest.config.ts", ".swcrc", "package.json"]
    },
    "lint": {
      "inputs": ["src/**", "package.json"]
    }
  }
}
