{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsup.config.ts",
        ".swcrc",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "inputs": ["src/**/*.graphql", "codegen.config.ts", "package.json"],
      "outputs": ["src/**/*.generated.ts"]
    },
    "backend#schema:print": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.graphql", "package.json"],
      "outputs": ["$TURBO_ROOT$/packages/api-schema/schema.graphql"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["codegen"],
      "inputs": [
        "src/**",
        "test/**",
        "drizzle.config.ts",
        "codegen.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "migrations/**",
        "vitest.config.ts",
        ".swcrc",
        "package.json"
      ],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "lint": {
      "inputs": ["src/**", "package.json"]
    }
  }
}
