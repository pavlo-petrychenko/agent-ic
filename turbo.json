{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "index.html",
        "vite.config.ts",
        "tsup.config.ts",
        ".swcrc",
        "tsconfig.json",
        "package.json",
        "$TURBO_ROOT$/tools/declaration-aliases.ts",
        "$TURBO_ROOT$/tools/declaration-aliases/**"
      ],
      "outputs": ["dist/**"]
    },
    "codegen": {
      "inputs": ["src/**/*.graphql", "codegen.config.ts", "package.json"],
      "outputs": ["src/**/*.generated.ts"]
    },
    "backend#schema:print": {
      "dependsOn": ["build"],
      "inputs": ["src/**/*.graphql", "package.json"],
      "outputs": ["$TURBO_ROOT$/packages/api-schema/schema.graphql"]
    },
    "web#codegen": {
      "dependsOn": ["backend#schema:print"],
      "inputs": [
        "src/**/*.graphql",
        "src/routes/**",
        "codegen.config.ts",
        "package.json",
        "$TURBO_ROOT$/packages/api-schema/schema.graphql"
      ],
      "outputs": ["src/**/*.generated.ts", "src/routeTree.gen.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["codegen"],
      "inputs": [
        "src/**",
        "test/**",
        ".storybook/**",
        "drizzle.config.ts",
        "codegen.config.ts",
        "tsconfig.json",
        "package.json"
      ]
    },
    "test": {
      "inputs": [
        "src/**",
        "test/**",
        "migrations/**",
        "vitest.config.ts",
        ".swcrc",
        "package.json"
      ],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "lint": {
      "inputs": ["src/**", "package.json"]
    },
    "web#build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "vite.config.ts",
        "vite.*.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "web#test": {
      "dependsOn": ["codegen"],
      "inputs": ["src/**", "test/**", "vitest.config.ts", "vite.*.ts", "package.json"]
    },
    "web#storybook:build": {
      "dependsOn": ["^build", "codegen"],
      "inputs": [
        "src/**",
        "test/**",
        ".storybook/**",
        "public/**",
        "vite.config.ts",
        "vite.*.ts",
        "tsconfig.json",
        "package.json"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
