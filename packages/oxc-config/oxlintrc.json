{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "node",
    "import",
    "react",
    "react-perf",
    "jsx-a11y",
    "vitest"
  ],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "no-console": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "node/no-process-env": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.cjs",
        "**/*.config.mjs",
        "**/routes/**",
        "**/*.stories.tsx",
        "**/.storybook/*"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/apps/backend/**"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["**/apps/backend/src/platform/config/**"],
      "rules": {
        "node/no-process-env": "off"
      }
    },
    {
      "files": [
        "**/apps/*/src/**",
        "**/apps/*/test/**",
        "**/packages/*/src/**",
        "**/packages/*/test/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^\\.{1,2}(/|$)",
                "message": "Use an absolute import: @/… or @test/… in apps, @<package>/… or @test/… in packages."
              },
              {
                "regex": "^#",
                "message": "Use a path alias, not a Node subpath import: @/… in apps, @<package>/… in packages."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.generated.ts", "**/*.gen.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/.claude/**"
  ]
}
