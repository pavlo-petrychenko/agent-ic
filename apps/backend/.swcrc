{
  "$schema": "https://swc.rs/schema.json",
  "jsc": {
    "target": "es2024",
    "parser": {
      "syntax": "typescript",
      "decorators": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "keepClassNames": true
  },
  "module": {
    "type": "es6",
    "resolveFully": true
  },
  "sourceMaps": true
}
