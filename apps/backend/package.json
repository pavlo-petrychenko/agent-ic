{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist",
    "migrations"
  ],
  "type": "module",
  "scripts": {
    "build": "swc src -d dist --strip-leading-paths --delete-dir-on-start --copy-files --ignore \"**/*.spec.ts\"",
    "build:dev": "swc src -d .dev/dist --strip-leading-paths --delete-dir-on-start --copy-files --ignore \"**/*.spec.ts\"",
    "dev:api": "nodemon -- serve --role=api",
    "dev:gateway": "nodemon -- serve --role=gateway",
    "dev:worker": "nodemon -- serve --role=worker",
    "dev": "pnpm dev:api",
    "start": "node dist/main.js serve",
    "migrate": "node dist/main.js migrate",
    "schema:print": "node dist/main.js print-schema --output=../../packages/api-schema/schema.graphql",
    "db:migrate": "pnpm build && pnpm migrate",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-ic/contracts": "workspace:*",
    "@agent-ic/flow": "workspace:*",
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@bull-board/api": "9.10.2",
    "@bull-board/express": "9.10.2",
    "@nestjs-cls/transactional": "^4.0.1",
    "@nestjs-cls/transactional-adapter-drizzle-orm": "^2.0.1",
    "@nestjs/apollo": "^14.0.3",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/graphql": "^14.0.3",
    "@nestjs/platform-express": "^12.1.2",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@react-email/render": "^2.1.0",
    "bullmq": "6.3.11",
    "drizzle-orm": "^0.45.3",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.12",
    "nestjs-cls": "^7.0.1",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.0.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "proxy-addr": "^2.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@agent-ic/tsconfig": "workspace:*",
    "@graphql-codegen/cli": "^7.4.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@nestjs/testing": "^12.1.2",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@testcontainers/postgresql": "^12.2.0",
    "@testcontainers/redis": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/nodemailer": "^8.0.2",
    "@types/proxy-addr": "^2.0.3",
    "@types/react": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
