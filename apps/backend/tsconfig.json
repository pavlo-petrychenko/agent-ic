{
  "extends": "@agent-ic/tsconfig/node.json",
  "include": ["src", "test", "vitest.config.ts", "drizzle.config.ts", "codegen.config.ts"],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "paths": {
      "@/*": ["./src/*"],
      "@test/*": ["./test/*"],
      "@contracts/*": ["../../packages/contracts/src/*"],
      "@flow/*": ["../../packages/flow/src/*"]
    }
  }
}
