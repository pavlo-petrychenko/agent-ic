{
  "name": "agent-ic",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "test": "turbo run test && pnpm test:tools",
    "test:tools": "node --test tools/check-structure/check-structure.test.ts tools/declaration-aliases/*.test.ts tools/dev/*.test.ts",
    "stack": "node tools/dev.ts",
    "lint": "oxlint --type-aware",
    "format": "oxfmt -c packages/oxc-config/oxfmt.json '!docs/**' '!**/AGENTS.md' '!**/CLAUDE.md' '!pnpm-lock.yaml' '!apps/backend/migrations/**' '!deploy/helm/**/templates/**'",
    "format:check": "oxfmt -c packages/oxc-config/oxfmt.json '!docs/**' '!**/AGENTS.md' '!**/CLAUDE.md' '!pnpm-lock.yaml' '!apps/backend/migrations/**' '!deploy/helm/**/templates/**' --check",
    "depcruise": "depcruise apps/backend/src --config .dependency-cruiser.cjs --ts-config \"$PWD/tools/depcruise/backend.tsconfig.json\" && depcruise apps/web/src --config .dependency-cruiser.cjs --ts-config \"$PWD/tools/depcruise/web.tsconfig.json\" && depcruise packages --config .dependency-cruiser.cjs --ts-config \"$PWD/tools/depcruise/packages.tsconfig.json\"",
    "check:comments": "node tools/check-comments.ts",
    "check:structure": "node tools/check-structure.ts",
    "check": "pnpm lint && pnpm format:check && pnpm check:comments && pnpm check:structure && pnpm depcruise && pnpm typecheck",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:seed": "echo \"db:seed: no seed data yet\"",
    "codegen": "turbo run codegen backend#schema:print"
  },
  "devDependencies": {
    "@agent-ic/oxc-config": "workspace:*",
    "@agent-ic/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "lefthook": "^2.1.16",
    "oxc-parser": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
