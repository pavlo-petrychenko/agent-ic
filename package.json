{
  "name": "agent-ic",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck && pnpm typecheck:tools",
    "typecheck:tools": "tsc -p tools/tsconfig.json",
    "test": "turbo run test",
    "lint": "oxlint --type-aware",
    "format": "oxfmt -c packages/oxc-config/oxfmt.json '!docs/**' '!**/AGENTS.md' '!**/CLAUDE.md' '!pnpm-lock.yaml'",
    "format:check": "oxfmt -c packages/oxc-config/oxfmt.json '!docs/**' '!**/AGENTS.md' '!**/CLAUDE.md' '!pnpm-lock.yaml' --check",
    "depcruise": "depcruise apps/backend/src --config .dependency-cruiser.cjs --ts-config \"$PWD/tools/depcruise/backend.tsconfig.json\" && depcruise apps/web/src --config .dependency-cruiser.cjs --ts-config \"$PWD/tools/depcruise/web.tsconfig.json\" && depcruise packages --config .dependency-cruiser.cjs",
    "check:comments": "node tools/check-comments.ts",
    "check": "pnpm lint && pnpm format:check && pnpm check:comments && pnpm depcruise && pnpm typecheck",
    "db:migrate": "echo \"db:migrate: no migrations yet\"",
    "db:seed": "echo \"db:seed: no seed data yet\"",
    "codegen": "echo \"codegen: nothing to generate yet\"",
    "e2e": "echo \"e2e: no end-to-end tests yet\""
  },
  "devDependencies": {
    "@agent-ic/oxc-config": "workspace:*",
    "@agent-ic/tsconfig": "workspace:*",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.5.0",
    "lefthook": "^2.1.16",
    "oxc-parser": "^0.152.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
